{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "MEGALADATA_AI_AGENT_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "MEGALADATA_AI_AGENT_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "@opencode-ai/plugin#build": {
      "dependsOn": ["@opencode-ai/sdk#build"],
      "outputs": ["dist/**"]
    },
    "opencode#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@megaladata-ai-agent/megaladata-host#test": {
      "outputs": [],
      "passThroughEnv": ["MEGALADATA_AI_AGENT_TEST_NODE", "MEGALADATA_AI_AGENT_TEST_BROWSERS"]
    },
    "@megaladata-ai-agent/product#test": {
      "outputs": []
    },
    "@opencode-ai/core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@opencode-ai/function#test": {
      "outputs": []
    },
    "@opencode-ai/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@opencode-ai/ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@opencode-ai/session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
